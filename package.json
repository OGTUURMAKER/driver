{
  "name": "driving-test-app",
  "version": "1.0.0",
  "description": "Simple driving course practice test app with time-limited student access",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "import:images": "node scripts/import-images.js",
    "convert:images": "node scripts/convert-images.js",
    "generate:data": "node scripts/generate-data.js",
    "generate:regular-zh": "node scripts/generate-regular-zh.js",
    "validate": "node scripts/validate.js",
    "import:category-upgrade": "node scripts/import-category-upgrade.js",
    "generate:category-upgrade": "node scripts/generate-category-upgrade.js",
    "validate:category-upgrade": "node scripts/validate-category-upgrade.js",
    "test:category-upgrade": "node scripts/test-category-upgrade.js",
    "validate:i18n": "node scripts/validate-i18n.js",
    "validate:all": "npm run validate && npm run validate:category-upgrade && npm run validate:i18n",
    "test": "node scripts/test-category-upgrade.js"
  },
  "license": "MIT",
  "devDependencies": {
    "sharp": "^0.35.1"
  },
  "dependencies": {
    "mongodb": "^7.3.0"
  }
}
